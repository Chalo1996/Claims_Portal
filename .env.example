
# Database — Supabase connection pooler (Transaction mode, port 6543)
# Get these from: Supabase Dashboard → Project Settings → Database → Connection pooling
DB_HOST=aws-0-<region>.pooler.supabase.com
DB_PORT=6543
DB_NAME=postgres
DB_USER=postgres.<your-project-ref>
DB_PASSWORD=your_db_password
# POSTGRES_URL takes precedence if set — encode special chars in password (%40 for @, %23 for #)
POSTGRES_URL=postgresql://postgres.<your-project-ref>:your_db_password@aws-0-<region>.pooler.supabase.com:6543/postgres

# Server
PORT=5000
NODE_ENV=development

# Auth
JWT_SECRET=change-this-to-a-long-random-secret-in-production
JWT_EXPIRES_IN=8h

# CORS — set to your frontend URL in production
CORS_ORIGIN=http://localhost:3000

# Frontend — leave blank in dev (Vite proxy handles /api)
VITE_API_URL=
